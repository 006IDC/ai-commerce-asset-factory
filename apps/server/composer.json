{
    "name": "006idc/ai-commerce-asset-factory",
    "description": "Open-source AI commerce asset generation workspace",
    "type": "project",
    "keywords": [
        "ai-commerce",
        "ecommerce",
        "thinkphp",
        "image-generation"
    ],
    "homepage": "https://github.com/006IDC/ai-commerce-asset-factory",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "006IDC"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "phpmailer/phpmailer": "^6.10"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.3",
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ],
        "audit:production": "@composer audit --locked --no-dev",
        "test:contracts": "@php tests/run-contracts.php"
    }
}
