APP_DEBUG = true
APP_TIMEZONE = Asia/Shanghai
APP_PUBLIC_URL = https://studio.example.com
# 使用 PHP random_bytes 生成 32 字节随机值，再添加 base64: 前缀。
APP_KEY =

DB_DRIVER = sqlite
DB_DATABASE = database/asset_factory.sqlite

# 常见 PHP 主机使用 MySQL：
# DB_DRIVER = mysql
# DB_HOST = 127.0.0.1
# DB_NAME = asset_factory
# DB_USER = asset_factory
# DB_PASS = change-me
# DB_PORT = 3306

# 生产环境使用 PostgreSQL：
# DB_DRIVER = pgsql
# DB_HOST = 127.0.0.1
# DB_NAME = asset_factory
# DB_USER = asset_factory
# DB_PASS = change-me
# DB_PORT = 5432
DB_CHARSET = utf8mb4

DEFAULT_LANG = zh-cn
COOKIE_SECURE = false
SESSION_EXPIRE = 7200
# 开源默认关闭首次配置门禁；需要向导时可显式改为 true。
ADMIN_ONBOARDING_ENABLED = false

ADMIN_EMAIL = admin@example.com
# 仅首次 app:install 使用；生产环境必须设置强随机密码，初始化后可移除。
ADMIN_INITIAL_PASSWORD =

DEFAULT_IMAGE_MODEL = doubao-seedream-5-0-260128
DEFAULT_IMAGE_EDIT_MODE = auto
DEFAULT_VISION_MODEL = glm-4.6v
AI_ROUTING_MODE = capability
AI_ROUTING_GRAY_MERCHANT_IDS = []
# 内部能力固定由 ThinkPHP 渠道账号池执行；以下值仅保留部署兼容。
AI_EXECUTION_MODE = native
AI_NATIVE_CAPABILITIES = ["safety_text","content_planner","safety_vision","product_vision"]
IMAGE_GENERATION_CREDITS = 8
VIDEO_GENERATION_CREDITS_PER_SECOND = 6
PRODUCT_RECOGNITION_CREDITS = 0

# `ai:finalize-native-pool` 建议从独立的 0600 权限凭据文件读取以下值。
# QAQ Image 可通过自有 HTTPS Sub2API 网关接入；基础地址应包含 `/v1`。
# QAQ_IMAGE_BASE_URL = https://ai-gateway.example.com/v1
# QAQ_IMAGE_API_KEY =

GEETEST_CAPTCHA_ID =
GEETEST_PRIVATE_KEY =

CONTENT_SAFETY_ENABLED = 1
CONTENT_SAFETY_EXTERNAL_ENABLED = 1
CONTENT_SAFETY_FAIL_CLOSED = 1
CONTENT_SAFETY_MODEL = deepseek-v4-flash
CONTENT_SAFETY_FALLBACK_MODEL = deepseek-v4-pro
CONTENT_SAFETY_PENALTY_CREDITS = 5

SMTP_HOST =
SMTP_PORT = 465
SMTP_ENCRYPTION = ssl
SMTP_USERNAME =
SMTP_PASSWORD =
SMTP_FROM_EMAIL =
SMTP_FROM_NAME = AI 电商素材工厂
